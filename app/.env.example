# RPC used by the browser (optional; defaults to the official public endpoint which is rate-limited)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id (optional; without it only injected/Rabby/Coinbase wallets are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $GAPG project token address. EMPTY = token features hidden (disputes handled by the Timelock committee).
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock, comma-separated ISO country codes, e.g. US,CU,IR,KP,SY
NEXT_PUBLIC_BLOCKED_COUNTRIES=
# Local fork development only
NEXT_PUBLIC_ENABLE_FORK=false
NEXT_PUBLIC_FORK_RPC_URL=http://127.0.0.1:8545
# Address that `anvil --auto-impersonate` will sign for (no private key needed)
NEXT_PUBLIC_FORK_DEV_WALLET=
